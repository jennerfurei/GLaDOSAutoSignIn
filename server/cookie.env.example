# /opt/glados-checkin/cookie.env —— 敏感文件，权限 600
# 浏览器登录 glados.network 后，F12 -> Network -> 任意请求 -> Request Headers 里的 Cookie，
# 把 koa:sess 和 koa:sess.sig 两段完整拷进来（分号+空格分隔，整行放在引号里）。
GLADOS_COOKIE="koa:sess=xxxxxxxxxxxxxxxxxxxxxx; koa:sess.sig=yyyyyyyyyy"

# 可选：飞书群机器人 webhook，签到失败时告警（留空则不发通知）
FEISHU_WEBHOOK=""
